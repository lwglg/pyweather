# ETL — valores de DESENVOLVIMENTO (sem segredos).
# A chave da OpenWeather NÃO deve ser versionada: defina-a em infra/docker/etl/.env.local
# (ignorado pelo git) ou exporte OPENWEATHER_API_KEY no shell antes de `make up`.
OPENWEATHER_BASE_URL=https://api.openweathermap.org
OPENWEATHER_UNITS=metric
OPENWEATHER_LANG=pt_br
HTTP_TIMEOUT_SECONDS=15
HTTP_MAX_RETRIES=3

# Cidade-alvo (se CITY_LATITUDE/CITY_LONGITUDE forem informadas, a geocodificação é dispensada)
CITY_NAME=Florianópolis
CITY_STATE=Santa Catarina
CITY_COUNTRY=BR

# Extração periódica
ETL_INTERVAL_SECONDS=3600
ETL_HOURLY_PAGES=3
ETL_DAILY_PAGES=1
ETL_INCLUDE_ALERTS=true

# Banco (o host é o nome do serviço no Compose)
POSTGRES_HOST=database
POSTGRES_PORT=5432
POSTGRES_DB=pyweather
POSTGRES_USER=pyweather
POSTGRES_PASSWORD=pyweather

LOG_LEVEL=INFO
