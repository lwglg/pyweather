# Newman — executor dos smoke tests (o environment `docker` aponta para http://api:8000).
POSTMAN_COLLECTION=pyweather.postman_collection.json
POSTMAN_ENVIRONMENT=pyweather.docker.postman_environment.json
# Endpoint usado para saber que o ETL terminou a primeira extração (o local é criado com id 1).
WAIT_URL=http://api:8000/v1/locations/1/forecast/daily
WAIT_TIMEOUT=180
RESULTS_DIR=/results
